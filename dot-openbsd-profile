#
# sh/ksh initialization
export LC_ALL="de_DE.UTF-8"

PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/X11R6/bin:/usr/local/sbin:/usr/local/bin
export PATH

: ${HOME='/root'}
export HOME

ENV="$HOME/.kshrc"
export ENV

# Prompt-Farbe: root rot, normale Benutzer grün
ESC=$(printf '\033')
if [ "$(id -u)" -eq 0 ]; then
    PS1="${ESC}[0;31m[\h:\w]\n\$ ${ESC}[m"
else
    PS1="${ESC}[0;32m[\h:\w]\n\$ ${ESC}[m"
fi
export PS1

# History: bevorzugt im HOME, Fallback nach /var/tmp falls HOME nicht beschreibbar ist
HISTSIZE=10000
export HISTSIZE

if [ -d "$HOME" ] && [ -w "$HOME" ]; then
    HISTFILE="$HOME/.history"
else
    histdir="/var/tmp/ksh-history-$(id -u)"
    if [ ! -d "$histdir" ]; then
        mkdir -m 700 "$histdir" 2>/dev/null
    fi
    if [ -d "$histdir" ] && [ -O "$histdir" ]; then
        chmod 700 "$histdir" 2>/dev/null
        HISTFILE="$histdir/history"
    else
        HISTFILE="/var/tmp/.history-$(id -u)"
    fi
fi
export HISTFILE

umask 022

case "$-" in
*i*)    # interactive shell
    if [ -x /usr/bin/tset ]; then
        if [ X"$XTERM_VERSION" = X"" ]; then
            eval `/usr/bin/tset -sQ '-munknown:?vt220' $TERM`
        else
            eval `/usr/bin/tset -IsQ '-munknown:?vt220' $TERM`
        fi
    fi
    ;;
esac

alias rw='mount -uw /'
alias ro='mount -ur /'
